# Copy to .env locally. Never commit a real key or hook address.
# Dashboard: create an API key, then replace the placeholder.

AINOFLOW_API_KEY=YOUR_API_KEY

# Optional Inbox hook emails (from an Ainoflow inbox). Required only for Smoke B
# in TESTING.md. Leave the placeholders if you have no inbox — skip Smoke B.

AINOFLOW_INVOICE_INBOX_EMAIL=YOUR_INVOICE_INBOX_EMAIL
AINOFLOW_TRIAGE_INBOX_EMAIL=YOUR_TRIAGE_INBOX_EMAIL
